# ============================================================
# DATABASE MIGRATIONS
# ============================================================

# IMPORTANT:
# Do not ignore Alembic migrations or Django migrations.
# They are normally part of the source code and should be committed.
#
# Keep:
# alembic/versions/
# */migrations/*.py
#
# Ignore only Python migration cache files through __pycache__/.

